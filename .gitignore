ocp/.metadata/
ocp/.obsidian/
ocp/CallBeep/
cop/Servers/

設定內容如下:

# ==========================================
# 1. 系統環境與作業系統垃圾檔
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ==========================================
# 2. 開發工具與編輯器設定 (IDE)
# ==========================================
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.user
*.sln.docstates

# ==========================================
# 3. 大型套件與依賴套件庫 (Node, Python, Java)
# ==========================================
node_modules/
/npm-debug.log*
venv/
.venv/
__pycache__/
*.pyc
target/
.gradle/
build/

# ==========================================
# 4. 機密資訊與環境變數檔 (安全關鍵)
# ==========================================
.env
.env.local
.env.development.local
*.pem
*.key

# ==========================================
# 5. 紀錄檔與暫存壓縮檔
# ==========================================
*.log
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip









